<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dash_bg"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- Avatar -->
        <TextView
            android:id="@+id/profileAvatar"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_profile_avatar"
            android:gravity="center"
            android:text="JD"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/profileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Juan Dela Cruz"
            android:textColor="#111827"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Member Badge -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_badge_blue"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="⭐  Premium Member"
            android:textColor="#1D4ED8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Contact Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📧" android:textSize="16sp" />
                <TextView
                    android:id="@+id/profileEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="juan.delacruz@email.com"
                    android:textColor="#374151"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/phoneRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="10dp" android:background="#F1F5F9" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📱" android:textSize="16sp" />
                    <TextView
                        android:id="@+id/profilePhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:textColor="#374151"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Stats Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stat_card"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="16dp">
                <TextView android:id="@+id/statQueuesJoined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#2563EB" android:textSize="28sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Queues Joined" android:textColor="#6B7280" android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stat_card"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="16dp">
                <TextView android:id="@+id/statTimeSaved" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#2563EB" android:textSize="28sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Time Saved" android:textColor="#6B7280" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Menu Options -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical">

            <!-- Account Settings -->
            <LinearLayout android:id="@+id/menuAccountSettings" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/bg_ripple" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:paddingHorizontal="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚙️" android:textSize="18sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="Account Settings" android:textColor="#111827" android:textSize="15sp" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right_24" android:contentDescription="Go" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="46dp" android:background="#F1F5F9" />

            <!-- Notifications -->
            <LinearLayout android:id="@+id/menuNotifications" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/bg_ripple" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:paddingHorizontal="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔔" android:textSize="18sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="Notifications" android:textColor="#111827" android:textSize="15sp" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right_24" android:contentDescription="Go" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="46dp" android:background="#F1F5F9" />

            <!-- Queue History -->
            <LinearLayout android:id="@+id/menuQueueHistory" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/bg_ripple" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:paddingHorizontal="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📋" android:textSize="18sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="Queue History" android:textColor="#111827" android:textSize="15sp" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right_24" android:contentDescription="Go" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="46dp" android:background="#F1F5F9" />

            <!-- Log Out -->
            <LinearLayout android:id="@+id/menuLogout" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/bg_ripple" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:paddingHorizontal="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🚪" android:textSize="18sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="Log Out" android:textColor="#EF4444" android:textSize="15sp" android:textStyle="bold" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right_24" android:contentDescription="Go" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
