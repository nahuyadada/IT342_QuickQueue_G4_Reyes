<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" >

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuickQueue"
        tools:targetApi="31" >
        <activity
            android:name=".auth.Registration"
            android:exported="false" />
        <activity
            android:name=".profile.AccountSettingsActivity"
            android:exported="false"
            android:label="Account Settings"
            android:parentActivityName=".dashboard.DashboardActivity" />
        <activity
            android:name=".notifications.NotificationsActivity"
            android:exported="false"
            android:label="Notifications"
            android:parentActivityName=".dashboard.DashboardActivity" />
        <activity
            android:name=".queue.QueueHistoryActivity"
            android:exported="false"
            android:label="Queue History"
            android:parentActivityName=".dashboard.DashboardActivity" />
        <activity
            android:name=".queue.BranchDetailActivity"
            android:exported="false"
            android:label="Branch Detail"
            android:parentActivityName=".dashboard.DashboardActivity" />
        <activity
            android:name=".dashboard.DashboardActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.QuickQueue" />
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.QuickQueue" />
        <activity
            android:name=".auth.Login"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.QuickQueue" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>